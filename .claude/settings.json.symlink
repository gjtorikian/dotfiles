{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gjtorikian/.dotfiles/.claude/hooks/fix-env-lazy-load.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gjtorikian/.dotfiles/.claude/hooks/track-start-time.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gjtorikian/.dotfiles/.claude/hooks/sounds-on-task-complete.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/gjtorikian/.dotfiles/bin/claude-status"
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true,
    "ideation@nicknisi": true,
    "consultant@nicknisi": true,
    "skill-creator@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "agents@gjtorikian-plugins": true,
    "github@gjtorikian-plugins": true,
    "git@gjtorikian-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "sessions@sessions": true,
    "swift-lsp@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "sessions": {
      "source": {
        "source": "directory",
        "path": "/Users/gjtorikian/.local/share/sessions"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true
}
