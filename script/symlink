#!/usr/bin/env bash
#
# Re-apply symlinks without running the full bootstrap.

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e

PI_HOSTNAME="${PI_HOST:-$(hostname -s)}"

echo ''

info () {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit
}

link_file () {
  local src=$1 dst=$2

  # Skip if symlink already points to the correct target
  if [ -L "$dst" ] && [ "$(readlink "$dst")" == "$src" ]; then
    return
  fi

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]; then
    rm -rf "$dst"
    success "removed $dst"
  fi

  ln -s "$src" "$dst"
  success "linked $src to $dst"
}

# Directories that need to be nested (symlinked into subdirectories of $HOME)
NESTED_DIRS=(
  ".ssh"
  ".claude"
  ".config/ghostty"
  ".config/zed"
)

# Check if a source path should be nested, and if so, link it to the appropriate directory
# Returns 0 (true) if handled as nested, 1 (false) if not
link_nested () {
  local src=$1
  local filename=$2

  for nested_dir in "${NESTED_DIRS[@]}"; do
    if [[ $src == *"$nested_dir"* ]]; then
      filename="${filename:1}"  # strip leading dot
      mkdir -p "$HOME/$nested_dir"
      link_file "$src" "$HOME/$nested_dir/$filename"
      return 0
    fi
  done

  return 1
}

# Resolve host-specific override for a source file.
# Looks for hosts/<hostname>/<basename> next to the source file's parent dir.
# e.g. .claude/settings.json.symlink → .claude/hosts/Nezu/settings.json.symlink
resolve_host_override () {
  local src=$1
  local dir=$(dirname "$src")
  local name=$(basename "$src")
  local host_src="$dir/hosts/$PI_HOSTNAME/$name"
  if [ -f "$host_src" ]; then
    info "host override ($PI_HOSTNAME) → ${host_src#$DOTFILES_ROOT/}" >&2
    echo "$host_src"
  else
    echo "$src"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  for src in $(find -H "$DOTFILES_ROOT" -maxdepth 3 -name '*.symlink' -not -path '*.git*' -not -path '*/hosts/*')
  do
    src=$(resolve_host_override "$src")
    filename=".$(basename "${src%.*}")"
    dst="$HOME/$filename"

    # Try to link as nested; if not nested, link to $HOME directly
    if ! link_nested "$src" "$filename"; then
      link_file "$src" "$dst"
    fi
  done
}

install_dotfiles

# Pi host-specific config.
#
# pi/pi.zsh points PI_CODING_AGENT_DIR at pi/ in this repo, so pi reads
# extensions/, lib/, configs/ and friends straight out of the checkout — they
# need no linking. Only the files whose contents differ per machine do, and
# those are linked *in place*: pi/<name> becomes a symlink to
# pi/hosts/<host>/<name>. The pi/ copies are gitignored; the hosts/ copies are
# the tracked source of truth.
#
# settings.json is written back to by pi (`pi install`, /theme,
# lastChangelogVersion), and those writes follow the symlink into the host
# file — so a `pi install` on one machine does NOT reach the other. Mirror it
# by hand, or run the install on both.
info "linking pi host config ($PI_HOSTNAME)"
PI_HOST_DIR="$DOTFILES_ROOT/pi/hosts/$PI_HOSTNAME"
if [ -d "$PI_HOST_DIR" ]; then
  for src in "$PI_HOST_DIR"/*; do
    [ -f "$src" ] || continue
    link_file "$src" "$DOTFILES_ROOT/pi/$(basename "$src")"
  done
else
  printf "\r\033[2K  [\033[0;33mWARN\033[0m] no pi/hosts/%s — copy an existing host dir to add this machine\n" "$PI_HOSTNAME"
fi

echo ''
echo '  Symlinks applied!'
