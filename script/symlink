#!/usr/bin/env bash
#
# Re-apply symlinks without running the full bootstrap.

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e

PI_HOSTNAME="${PI_HOST:-$(hostname -s)}"

echo ''

info () {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit
}

link_file () {
  local src=$1 dst=$2

  # Skip if symlink already points to the correct target
  if [ -L "$dst" ] && [ "$(readlink "$dst")" == "$src" ]; then
    return
  fi

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]; then
    rm -rf "$dst"
    success "removed $dst"
  fi

  ln -s "$src" "$dst"
  success "linked $src to $dst"
}

# Directories that need to be nested (symlinked into subdirectories of $HOME)
NESTED_DIRS=(
  ".ssh"
  ".claude"
  ".config/ghostty"
  ".config/zed"
)

# Check if a source path should be nested, and if so, link it to the appropriate directory
# Returns 0 (true) if handled as nested, 1 (false) if not
link_nested () {
  local src=$1
  local filename=$2

  for nested_dir in "${NESTED_DIRS[@]}"; do
    if [[ $src == *"$nested_dir"* ]]; then
      filename="${filename:1}"  # strip leading dot
      mkdir -p "$HOME/$nested_dir"
      link_file "$src" "$HOME/$nested_dir/$filename"
      return 0
    fi
  done

  return 1
}

# Resolve host-specific override for a source file.
# Looks for hosts/<hostname>/<basename> next to the source file's parent dir.
# e.g. .claude/settings.json.symlink → .claude/hosts/Nezu/settings.json.symlink
resolve_host_override () {
  local src=$1
  local dir=$(dirname "$src")
  local name=$(basename "$src")
  local host_src="$dir/hosts/$PI_HOSTNAME/$name"
  if [ -f "$host_src" ]; then
    info "host override ($PI_HOSTNAME) → ${host_src#$DOTFILES_ROOT/}" >&2
    echo "$host_src"
  else
    echo "$src"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  for src in $(find -H "$DOTFILES_ROOT" -maxdepth 3 -name '*.symlink' -not -path '*.git*' -not -path '*/hosts/*')
  do
    src=$(resolve_host_override "$src")
    filename=".$(basename "${src%.*}")"
    dst="$HOME/$filename"

    # Try to link as nested; if not nested, link to $HOME directly
    if ! link_nested "$src" "$filename"; then
      link_file "$src" "$dst"
    fi
  done
}

install_dotfiles

# Pi agent config (with per-host overrides)
info 'linking pi agent config'
mkdir -p "$HOME/.pi/agent"
# Repo-tooling and generated files that live in pi/ but are not agent config.
# Linking package.json or tsconfig.json into ~/.pi/agent/ would hand pi a
# manifest that describes this repo's typecheck setup, not the agent.
PI_NOT_CONFIG=(package.json package-lock.json tsconfig.json mcp-cache.json)

for src in "$DOTFILES_ROOT"/pi/*.json "$DOTFILES_ROOT"/pi/*.md; do
  [ -f "$src" ] || continue
  name=$(basename "$src")
  skip=
  for excluded in "${PI_NOT_CONFIG[@]}"; do
    [ "$name" == "$excluded" ] && skip=1 && break
  done
  [ -n "$skip" ] && continue
  host_src="$DOTFILES_ROOT/pi/hosts/$PI_HOSTNAME/$name"
  if [ -f "$host_src" ]; then
    info "pi: host override ($PI_HOSTNAME) → $name"
    link_file "$host_src" "$HOME/.pi/agent/$name"
  else
    link_file "$src" "$HOME/.pi/agent/$name"
  fi
done

# Pi extensions and their support dirs.
#
# pi auto-loads every *.ts/*.js in ~/.pi/agent/extensions/. Linking each file
# individually (rather than the directory) keeps that dir writable, so a
# throwaway extension can still be dropped in by hand without git noticing.
#
# settings.json's `extensions` array is deliberately not used for these:
# relative paths there resolve against the *current working directory*, not the
# settings file, so they only load when pi runs from ~/.dotfiles.
info 'linking pi extensions'
mkdir -p "$HOME/.pi/agent/extensions"
for src in "$DOTFILES_ROOT"/pi/extensions/*; do
  [ -f "$src" ] || continue
  link_file "$src" "$HOME/.pi/agent/extensions/$(basename "$src")"
done

# Imported by extensions (lib) or read by them at runtime (configs). Linked as
# whole directories so adding a file needs no change here.
for dir in lib configs; do
  [ -d "$DOTFILES_ROOT/pi/$dir" ] || continue
  link_file "$DOTFILES_ROOT/pi/$dir" "$HOME/.pi/agent/$dir"
done

# Report anything pi would load that the repo does not track. Warn rather than
# delete: an untracked extension here is more likely to be unbackfilled work
# than garbage, and a silent rm is how that work gets lost.
for dst in "$HOME"/.pi/agent/extensions/*; do
  [ -e "$dst" ] || continue
  [ -L "$dst" ] && continue
  fail_msg="untracked, not in dotfiles: ${dst/#$HOME/~}"
  printf "\r\033[2K  [\033[0;33mWARN\033[0m] %s\n" "$fail_msg"
done

echo ''
echo '  Symlinks applied!'
